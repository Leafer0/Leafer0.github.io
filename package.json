{
  "name": "leafer-garden",
  "version": "1.0.0",
  "private": true,
  "description": "Leafer 的个人主页 —— GitHub Pages 静态站点",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i ./src/input.css -o ./style.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i ./src/input.css -o ./style.css --watch",
    "build:img": "node tools/optimize-images.js",
    "build:icons": "node tools/build-icons.js",
    "build": "npm run build:css && npm run build:icons",
    "serve": "node tools/serve.js"
  },
  "devDependencies": {
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "sharp": "^0.34.2",
    "tailwindcss": "^3.4.17"
  }
}
